# Gumroad API Configuration
# Generate your access token at: https://app.gumroad.com/settings/advanced
GUMROAD_ACCESS_TOKEN=your_access_token_here

# Ghost API Configuration
# Create a custom integration in Ghost Admin > Settings > Integrations
GHOST_SITE_URL=https://www.dsebastien.net
GHOST_ADMIN_API_KEY=your_admin_api_key_here
GHOST_CONTENT_API_KEY=your_content_api_key_here

# Plausible Analytics Configuration
# Get your API key from Plausible settings
PLAUSIBLE_API_KEY=your_plausible_api_key_here
PLAUSIBLE_SITE_ID=dsebastien.net
