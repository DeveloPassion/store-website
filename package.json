{
    "name": "store-website",
    "private": true,
    "version": "1.41.1",
    "description": "Product store website for dSebastien",
    "author": "Sébastien Dubois",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/DeveloPassion/store-website.git"
    },
    "bugs": {
        "url": "https://github.com/DeveloPassion/store-website/issues"
    },
    "homepage": "https://store.dsebastien.net",
    "scripts": {
        "store": "bun scripts/store-cli.ts",
        "aggregate:products": "bun scripts/utils/aggregate-products.ts",
        "dev": "bun run aggregate:products && bun scripts/utils/dev.ts",
        "build": "bun run aggregate:products && tsc && bun scripts/utils/build.ts && bun run generate:static-pages && bun run generate:sitemap && bun run generate:llms-txt && bun run generate:rss-feed && bun run generate:products-light",
        "generate:static-pages": "bun scripts/utils/generate-static-pages.ts",
        "generate:sitemap": "bun scripts/utils/generate-sitemap.ts",
        "generate:llms-txt": "bun scripts/utils/generate-llms-txt.ts",
        "generate:rss-feed": "bun scripts/utils/generate-rss-feed.ts",
        "generate:products-light": "bun scripts/utils/generate-products-light.ts",
        "preview": "bun --bun serve dist --port 4173",
        "preview:cloudflare": "wrangler pages dev dist",
        "prepare": "husky",
        "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
        "format": "prettier --write .",
        "validate": "bun run --parallel tsc test lint",
        "tsc": "tsc --noEmit",
        "tsc:watch": "tsc --noEmit --watch --preserveWatchOutput",
        "tscw": "bun run tsc:watch",
        "validate:products": "bun run aggregate:products && bun scripts/validate-products.ts",
        "validate:promotion": "bun scripts/validate-promotion.ts",
        "validate:taglines": "bun scripts/validate-taglines.ts",
        "update:promotion": "bun scripts/update-promotion.ts",
        "update:tags": "bun scripts/update-tags.ts",
        "update:categories": "bun scripts/update-categories.ts",
        "update:products": "bun scripts/update-products.ts",
        "update:taglines": "bun scripts/update-taglines.ts",
        "update:animated-hero-texts": "bun scripts/update-animated-hero-texts.ts",
        "sync:gumroad": "bun scripts/sync-gumroad.ts",
        "generate:redirects": "bun scripts/generate-redirects.ts",
        "ghost:stats": "bun scripts/ghost-stats.ts",
        "validate:relationships": "bun scripts/validate-relationships.ts",
        "validate:categories": "bun scripts/validate-categories.ts",
        "validate:tags": "bun scripts/validate-tags.ts",
        "validate:animated-hero-texts": "bun scripts/validate-animated-hero-texts.ts",
        "validate:global-faq": "bun scripts/validate-global-faq.ts",
        "validate:product-links": "bun scripts/validate-product-links.ts",
        "validate:product-icons": "bun scripts/validate-product-icons.ts",
        "validate:quiz": "bun scripts/validate-quiz.ts",
        "validate:all": "bun run --parallel validate:taglines validate:animated-hero-texts validate:promotion validate:global-faq validate:product-links validate:product-icons validate:quiz validate:relationships && bun run validate:products && bun run --parallel validate:categories validate:tags",
        "commit": "cz",
        "cm": "bun run commit",
        "commit:lint": "commitlint --from HEAD~1 --to HEAD --verbose",
        "release": "bash scripts/utils/release.sh",
        "release:update-version": "bun scripts/utils/update-version.ts",
        "release:changelog": "bun scripts/utils/generate-changelog.ts",
        "add": "bun run format && git add -A && bun run commit",
        "push": "git push && git push --tags",
        "test": "bun test",
        "test:run": "bun test",
        "test:coverage": "bun test --coverage",
        "ci:local": "bun run aggregate:products && bun run --parallel lint tsc test:run && bun run validate:all && bun run build",
        "audit:local": "lighthouse http://localhost:5173 --output=json --output=html --output-path=./lighthouse-reports/local --chrome-flags=\"--headless --no-sandbox\"",
        "audit:production": "lighthouse https://store.dsebastien.net --output=json --output=html --output-path=./lighthouse-reports/production --chrome-flags=\"--headless --no-sandbox\"",
        "optimize:images": "bun scripts/utils/optimize-images.ts"
    },
    "lint-staged": {
        "**/*": "prettier --write --ignore-unknown"
    },
    "config": {
        "commitizen": {
            "path": "node_modules/cz-customizable"
        },
        "cz-customizable": {
            "config": ".cz-config.cjs"
        }
    },
    "engines": {
        "node": ">=20.0"
    },
    "dependencies": {
        "@headlessui/react": "2.2.9",
        "@leeoniya/ufuzzy": "1.0.19",
        "clsx": "2.1.1",
        "date-fns": "4.1.0",
        "framer-motion": "12.25.0",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-icons": "5.5.0",
        "react-markdown": "10.1.0",
        "react-router": "7.12.0",
        "rehype-sanitize": "6.0.0",
        "remark-gfm": "4.0.1",
        "tailwind-merge": "3.4.0"
    },
    "devDependencies": {
        "@commitlint/cli": "20.3.1",
        "@commitlint/config-conventional": "20.0.0",
        "@eslint/js": "9.39.2",
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/react": "16.3.1",
        "@testing-library/user-event": "14.6.1",
        "@types/bun": "1.3.6",
        "@types/node": "25.0.9",
        "@types/react": "19.2.8",
        "@types/react-dom": "19.2.3",
        "commitizen": "4.3.1",
        "conventional-changelog-cli": "5.0.0",
        "conventional-changelog-conventionalcommits": "9.1.0",
        "conventional-commits-parser": "6.2.1",
        "cz-customizable": "7.5.1",
        "eslint": "9.39.2",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hooks": "7.0.1",
        "globals": "17.0.0",
        "happy-dom": "20.0.11",
        "husky": "9.1.7",
        "inquirer": "13.2.0",
        "lighthouse": "13.0.1",
        "lint-staged": "16.2.7",
        "prettier": "3.8.0",
        "prettier-plugin-tailwindcss": "0.7.2",
        "tailwindcss": "4.1.18",
        "typescript": "5.9.3",
        "typescript-eslint": "8.53.0",
        "wrangler": "4.95.0",
        "zod": "4.3.5"
    }
}
